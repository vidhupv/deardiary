# AgentPhone API key - get from dashboard.agentphone.ai
AGENTPHONE_API_KEY=ap_...

# No Anthropic API key needed!
# Note extraction uses the Claude Agent SDK, which authenticates via your
# local `claude` CLI (the same login Claude Code uses). Make sure you're
# logged in: `claude login`. Subscription credits cover usage.

# Phone number CB will call (your number, in E.164 format e.g. +12125551234).
# Each developer sets their own here so calls reach their own phone.
AMAN_PHONE_NUMBER=+1...

# CB's identity on AgentPhone — same agent for every developer, set once by
# whoever ran setup.py. If you ever rotate to a new agent, change these in
# every dev's .env (and .env.example for new clones).
AGENT_ID=cmpac3del0062a00ex04y22a7
AGENT_PHONE_NUMBER=+14782105637

# Optional: per-developer memory file for personal journaling/dev without
# trampling the shared demo state in memory.json. Create one with:
#   cd backend && python init_dev_memory.py <your-name>
# then point this env var at the file it generates. Defaults to memory.json
# (the shared Aman demo) if unset.
# DEARDIARY_MEMORY=memory.vidhu.json
